// Fish Farm - TEST CODE (fake data)

void setup() {
  Serial.begin(115200);
  delay(1000);
}

void loop() {
  float ph = random(650, 800) / 100.0;     // 6.50 - 8.00
  float oxygen = random(50, 100) / 10.0;   // 5.0 - 10.0 mg/L
  float turbidity = random(10, 50) / 10.0; // 1.0 - 5.0 NTU
  int waterLevel = random(40, 100);        // 40 - 100 %

  Serial.printf("{\"ph\":%.2f,\"oxygen\":%.1f,\"turbidity\":%.1f,\"water_level\":%d}\n", 
                ph, oxygen, turbidity, waterLevel);

  delay(2000);
}
